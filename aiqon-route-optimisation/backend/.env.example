# RouteWise Backend Environment Configuration
# Default: SQLite (zero-config local development)
DATABASE_URL=sqlite:///./aiqon.db

# Alternative: MySQL 8.0+
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
# Example: DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/routewise_db

APP_ENV=development
LOG_LEVEL=INFO

# Generative AI Logistics Assistant Configuration
# Supported providers: groq, openai, gemini
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-20b

